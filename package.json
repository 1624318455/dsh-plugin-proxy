{
  "name": "@tr1v3r/dsh-proxy",
  "version": "0.1.0",
  "description": "Runtime-switchable outbound proxy for the DeepSeek Harness: hot-reload HTTP(S)/SOCKS5 routing for every global-fetch request via a settings section.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "proxy",
    "socks5",
    "undici"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --test test/switch.test.mjs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dependencies": {
    "undici": "^8.10.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tr1v3r/dsh-proxy.git"
  },
  "homepage": "https://github.com/tr1v3r/dsh-proxy#readme",
  "bugs": {
    "url": "https://github.com/tr1v3r/dsh-proxy/issues"
  }
}
